<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Subscriptions Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_tv_focusable"
        android:padding="16dp"
        android:focusable="true"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌐 Подписка VLESS"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubscriptionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="81 узел"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/card_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubscriptionUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://xfizz.cc/sublink/..."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:ellipsize="middle"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvSubscriptionUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Обновлено: только что"
            android:textColor="@color/accent_mint"
            android:textSize="10sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateSub"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="🔄 Обновить"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_secondary_selector"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddSub"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="➕ Вставить URL"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_secondary_selector"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nodes Header & Hint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvNodesHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Узлы для Multi-Link"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Зажмите узел для опций"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Nodes List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
