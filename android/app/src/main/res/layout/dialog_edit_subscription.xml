<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvEditSubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Управление подпиской"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Редактирование параметров подписки и серверов"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="@color/border_card" />

    <!-- Expire badge / info -->
    <TextView
        android:id="@+id/tvEditSubExpire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="⏳ Осталось: 29 дней"
        android:textColor="@color/accent_gold"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Name input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Название подписки"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etEditSubName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/card_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <!-- URL input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="URL адрес подписки"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etEditSubUrl"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/card_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- Quick action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditSubRefresh"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/btn_secondary_selector"
            app:backgroundTint="@null"
            android:focusable="true"
            android:text="🔄 Обновить"
            android:textAllCaps="false"
            android:textColor="@color/accent_mint"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditSubShare"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/btn_secondary_selector"
            app:backgroundTint="@null"
            android:focusable="true"
            android:text="📤 Поделиться"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditSubSave"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/btn_primary_selector"
        app:backgroundTint="@null"
        android:focusable="true"
        android:text="💾 Сохранить изменения"
        android:textAllCaps="false"
        android:textColor="@color/bg_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditSubDelete"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/btn_secondary_selector"
        app:backgroundTint="@null"
        android:focusable="true"
        android:text="🗑️ Удалить подписку"
        android:textAllCaps="false"
        android:textColor="@color/accent_red"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditSubCancel"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/btn_secondary_selector"
        app:backgroundTint="@null"
        android:focusable="true"
        android:text="Отмена"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</LinearLayout>
